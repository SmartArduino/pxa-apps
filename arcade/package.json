{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    1,
    0
  ],
  "target_sdk": [
    1,
    0
  ],
  "compile_sdk": [
    1,
    0
  ],
  "id": "pxa-arcade",
  "version": "0.1.2",
  "release_sequence": 3,
  "name": "PXA Arcade",
  "description": "A collection of compact arcade games",
  "icon": "assets/flappy-bird/icon.png",
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "sources": [
        "main.c",
        "modules/brick_breaker.c",
        "modules/flappy_bird.c",
        "modules/jump_jump.c",
        "modules/jumping.c",
        "modules/minesweeper.c",
        "modules/tetris.c"
      ],
      "services": [
        "audio",
        "clock",
        "permission",
        "window",
        "log",
        {
          "name": "ui",
          "features": [
            "canvas"
          ]
        }
      ]
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ]
}
