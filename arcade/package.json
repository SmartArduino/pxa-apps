{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-arcade",
  "version": "0.1.3",
  "release_sequence": 4,
  "name": "PXA Arcade",
  "description": "A collection of compact arcade games",
  "icon": "assets/flappy-bird/icon.png",
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "audio",
        "clock",
        "permission",
        "window",
        "log",
        {
          "name": "ui",
          "features": [
            "canvas"
          ]
        }
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": []
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "build": {
    "system": "cmake",
    "source_dir": "."
  }
}
