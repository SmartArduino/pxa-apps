-# Independent new-batch C++ games through the existing PXA C ABI.
+cmake_minimum_required(VERSION 3.20)
+project(pxa_ardubullets LANGUAGES C CXX)
+# Owner CMake boundary: frozen common remains byte-for-byte unchanged.
 list(APPEND CMAKE_MODULE_PATH "${PXA_CMAKE_MODULE_DIR}")
 set(PXA_CPP_SDK_DIR "")
 include(PxaGuest)
-set(ARDU_PXA_ROOT "${CMAKE_CURRENT_LIST_DIR}")
-if(ARDU_GAME STREQUAL "guessdots")
- set(ARDU_GAME_ID 3)
-elseif(ARDU_GAME STREQUAL "nightraid")
- set(ARDU_GAME_ID 4)
-elseif(ARDU_GAME STREQUAL "randocity")
- set(ARDU_GAME_ID 5)
-elseif(ARDU_GAME STREQUAL "shooter")
- set(ARDU_GAME_ID 6)
-elseif(ARDU_GAME STREQUAL "hollowseeker")
- set(ARDU_GAME_ID 7)
-elseif(ARDU_GAME STREQUAL "hopper")
- set(ARDU_GAME_ID 8)
-elseif(ARDU_GAME STREQUAL "batch6-foundation-probe")
- set(ARDU_GAME_ID 0)
-else()
- message(FATAL_ERROR "Unknown new-batch Arduboy game")
-endif()
+set(ARDU_PXA_ROOT "${CMAKE_CURRENT_LIST_DIR}/../arduboy-batch-20261010")
+set(ARDU_GAME_ID 11)
 set(ARDU_PROVIDER_SOURCES "${ARDU_PXA_ROOT}/compat.cpp")
 foreach(name Arduboy2 Arduboy2Data Arduboy2Audio Arduboy2Beep Sprites SpritesB)
  list(APPEND ARDU_PROVIDER_SOURCES "${ARDU_PXA_ROOT}/vendor/platform/${name}.cpp")
 endforeach()
-# Addon source, include paths and defines belong to the individual owner.
-pxa_add_component(pxa_main COMPONENT_ID main SOURCES "${ARDU_PXA_ROOT}/frontend.cpp" ${ARDU_PROVIDER_SOURCES} "${CMAKE_CURRENT_SOURCE_DIR}/game.cpp" ${ARDU_OWNER_EXTRA_SOURCES} INCLUDE_DIRS "${ARDU_PXA_ROOT}" "${ARDU_PXA_ROOT}/vendor/platform" ${ARDU_OWNER_INCLUDE_DIRS})
+set(ARDU_OWNER_SOURCES "${CMAKE_CURRENT_LIST_DIR}/owner/owner_compat.cpp")
+foreach(name MyArduboy2 MyArduboyPlaytune common game title menu logo)
+ list(APPEND ARDU_OWNER_SOURCES "${CMAKE_CURRENT_LIST_DIR}/vendor/platform/${name}.cpp")
+endforeach()
+pxa_add_component(pxa_main COMPONENT_ID main SOURCES "${CMAKE_CURRENT_LIST_DIR}/frontend.cpp" ${ARDU_PROVIDER_SOURCES} "${CMAKE_CURRENT_LIST_DIR}/game.cpp" ${ARDU_OWNER_SOURCES} INCLUDE_DIRS "${ARDU_PXA_ROOT}" "${ARDU_PXA_ROOT}/vendor/platform" "${CMAKE_CURRENT_LIST_DIR}/owner" "${CMAKE_CURRENT_LIST_DIR}/vendor/platform")
 target_compile_features(pxa_main PRIVATE cxx_std_17)
-target_compile_definitions(pxa_main PRIVATE ARDU_GAME_ID=${ARDU_GAME_ID} ARDUBOY_CORE ${ARDU_OWNER_COMPILE_DEFINITIONS})
+target_compile_definitions(pxa_main PRIVATE ARDU_GAME_ID=${ARDU_GAME_ID} ARDUBOY_CORE)
 target_compile_options(pxa_main PRIVATE -fno-exceptions -fno-rtti -fno-strict-aliasing -ffunction-sections -fdata-sections)
 target_link_options(pxa_main PRIVATE -Wl,--gc-sections -Wl,-z,stack-size=131072 -Wl,--export=malloc -Wl,--export=free -Wl,--wrap=__assert_fail -Wl,--wrap=abort -Wl,--wrap=exit)
