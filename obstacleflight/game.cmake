# Independent new-batch C++ games through the existing PXA C ABI.
list(APPEND CMAKE_MODULE_PATH "${PXA_CMAKE_MODULE_DIR}")
set(PXA_CPP_SDK_DIR "")
include("${CMAKE_CURRENT_LIST_DIR}/../common/retro-games/Build.cmake")
include_directories("${CMAKE_CURRENT_LIST_DIR}/../common/retro-games")
set(ARDU_PXA_ROOT "${CMAKE_CURRENT_LIST_DIR}/../common/retro-games/arduboy-batch-20261010")
set(ARDU_GAME_ID 9)
set(ARDU_PROVIDER_SOURCES "${ARDU_PXA_ROOT}/compat.cpp")
foreach(name Arduboy2 Arduboy2Data Arduboy2Audio Arduboy2Beep Sprites SpritesB)
 list(APPEND ARDU_PROVIDER_SOURCES "${ARDU_PXA_ROOT}/vendor/platform/${name}.cpp")
endforeach()
# Addon source, include paths and defines belong to the individual owner.
pxa_retro_component(pxa_main COMPONENT_ID main SOURCES "${CMAKE_CURRENT_SOURCE_DIR}/frontend.cpp" ${ARDU_PROVIDER_SOURCES} "${CMAKE_CURRENT_SOURCE_DIR}/game.cpp" ${ARDU_OWNER_EXTRA_SOURCES} INCLUDE_DIRS "${ARDU_PXA_ROOT}" "${ARDU_PXA_ROOT}/vendor/platform" ${ARDU_OWNER_INCLUDE_DIRS})
target_compile_features(pxa_main PRIVATE cxx_std_17)
target_compile_definitions(pxa_main PRIVATE ARDU_GAME_ID=${ARDU_GAME_ID} ARDUBOY_CORE ${ARDU_OWNER_COMPILE_DEFINITIONS})
target_compile_options(pxa_main PRIVATE -fno-exceptions -fno-rtti -fno-strict-aliasing -ffunction-sections -fdata-sections)
target_link_options(pxa_main PRIVATE -Wl,--gc-sections -Wl,-z,stack-size=131072 -Wl,--export=malloc -Wl,--export=free -Wl,--wrap=__assert_fail -Wl,--wrap=abort -Wl,--wrap=exit)
