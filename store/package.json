{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-store",
  "version": "0.8.5",
  "name": "App Store",
  "description": "浏览应用与游戏、查看兼容性、下载签名包、确认安装并检查更新。下载与安装由系统验证，支持已安装应用管理；需要联网及 Host 商店安装服务。",
  "icon": "assets/icon.png",
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": []
      }
    }
  ],
  "services": [
    "device",
    "net",
    "permission",
    "window",
    "ui",
    "clock",
    "log",
    "store-installer",
    "assets"
  ],
  "permissions": [
    {
      "name": "device.identity",
      "required": false,
      "scope": "mac.wifi.station.hardware"
    },
    {
      "name": "net.client",
      "required": false,
      "scope": "https://app.doit.am"
    }
  ],
  "release_sequence": 13,
  "build": {
    "system": "cmake",
    "source_dir": "."
  }
}
