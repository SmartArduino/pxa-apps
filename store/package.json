{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-store",
  "version": "0.8.13",
  "name": "App Store",
  "description": "边加载边浏览应用与游戏，查看图标、截图和兼容性，下载、安装并检查更新。支持已安装应用与下载管理；签名验证和安装由系统完成，需要联网及 Host 商店安装服务。",
  "icon": "assets/icon.png",
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      }
    }
  ],
  "services": [
    "device",
    "net",
    "permission",
    "window",
    {
      "name": "ui",
      "features": [
        "dynamic-text",
        "text-input-control"
      ]
    },
    "clock",
    "log",
    "store-installer",
    "assets"
  ],
  "permissions": [
    {
      "name": "device.identity",
      "required": false,
      "scope": "mac.wifi.station.hardware"
    },
    {
      "name": "net.client",
      "required": false,
      "scope": "https://app.doit.am"
    }
  ],
  "release_sequence": 21,
  "build": {
    "system": "cmake",
    "source_dir": "."
  }
}
