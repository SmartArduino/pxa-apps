{
  "format": "pxa-package-source-0.2",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "id": "pxa-quake",
  "version": "0.6.20",
  "name": "Quake · LibreQuake",
  "description": "Quake engine with automatically installed LibreQuake free first-level media and app-private saves",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 3670016,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "surface",
        {
          "name": "audio",
          "min_version": [
            0,
            10
          ]
        },
        "clock",
        "permission",
        "window",
        "log",
        "ui",
        {
          "name": "fs",
          "min_version": [
            0,
            3
          ],
          "features": [
            "app-media-root",
            "read-at",
            "scoped-roots"
          ]
        },
        {
          "name": "game-render",
          "min_version": [
            1,
            5
          ],
          "features": [
            "borrowed-indexed-blit"
          ]
        }
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      },
      "artifact": "aot",
      "execution_model": "main-loop"
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "release_sequence": 221,
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "icon": "assets/icon.png",
  "resources": {
    "manifest_sha256": "7d2bdce7f9bd0d317b40a780224e59cf1f13fd0f0000bf4b1479ae2cef021bb2"
  }
}
