{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-pinyin-ime-lite",
  "version": "1.0.4+pxa07",
  "name": "轻量拼音输入法",
  "description": "使用小字表逐字输入，支持九键、全键盘与中英文，适合资源较少的设备。没有完整版整词词库；安装后需在系统中选择输入法。",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 262144,
      "pinned": false
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "services": [
        "ui"
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      }
    },
    {
      "id": "provider",
      "kind": "service",
      "cmake_target": "pxa_provider",
      "services": [
        {
          "name": "ime",
          "features": [
            "latin",
            "pinyin",
            "provider",
            "t9"
          ]
        }
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      }
    }
  ],
  "release_sequence": 5,
  "icon": "assets/icon.png"
}
