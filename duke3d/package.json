{
  "format": "pxa-package-source-0.2",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "id": "pxa-duke3d",
  "version": "0.3.11",
  "name": "Duke Nukem 3D",
  "description": "Duke Nukem 3D with automatically installed original shareware data, native VOC and multi-track MIDI",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 5767168,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "surface",
        {
          "name": "audio",
          "min_version": [
            0,
            10
          ]
        },
        "clock",
        "permission",
        "window",
        "log",
        "ui",
        {
          "name": "fs",
          "min_version": [
            0,
            3
          ],
          "features": [
            "app-media-root",
            "read-at",
            "scoped-roots"
          ]
        },
        {
          "name": "game-render",
          "min_version": [
            1,
            2
          ],
          "features": [
            "borrowed-indexed-blit"
          ]
        }
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      },
      "artifact": "aot",
      "execution_model": "main-loop"
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "release_sequence": 212,
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "icon": "assets/icon.png",
  "resources": {
    "manifest_sha256": "8a6f4a65befeb7a1bb410d1dd408312fbc2c8c5297f8601f6fb3de0e48f7ce28"
  }
}
