{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-resource-scenes",
  "version": "0.1.3",
  "release_sequence": 4,
  "name": "Resource Scenes",
  "description": "演示文件纹理、异步加载与场景切换：共 20 张纹理，每次显示四张，并循环切换场景。适合验证资源生命周期。",
  "build": {
    "system": "cmake",
    "linear_memory": {
      "maximum_bytes": 131072,
      "pinned": true
    },
    "source_dir": "."
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "assets",
        "clock",
        {
          "name": "game-render",
          "features": [
            "asset-bindings"
          ]
        },
        "log",
        "audio",
        "permission"
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": []
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": true,
      "scope": "media"
    }
  ]
}
