{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-maze-spike",
  "version": "0.1.3",
  "release_sequence": 4,
  "name": "Maze Spike",
  "description": "Guest raycaster using a mapped RGB565 triple buffer and Host 2x presentation",
  "build": {
    "system": "cmake",
    "linear_memory": {
      "maximum_bytes": 1048576,
      "pinned": true
    },
    "source_dir": "."
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "window",
        "clock",
        "surface",
        "log"
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": []
      }
    }
  ]
}
