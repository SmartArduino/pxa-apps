{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-maze-evil",
  "version": "0.1.7",
  "name": "Maze Evil",
  "description": "Raycasting shooter with mapped RGB565 rendering, touch controls and Host-driven SFX",
  "build": {
    "system": "cmake",
    "linear_memory": {
      "maximum_bytes": 1048576,
      "pinned": true
    },
    "source_dir": "."
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "surface",
        "audio",
        "clock",
        "permission",
        "window",
        "log",
        "ui"
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": []
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "release_sequence": 8
}
