{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    1,
    0
  ],
  "target_sdk": [
    1,
    0
  ],
  "compile_sdk": [
    1,
    0
  ],
  "id": "pxa-maze-evil",
  "version": "0.1.3",
  "name": "Maze Evil",
  "description": "Raycasting shooter with mapped RGB565 rendering, touch controls and Host-driven SFX",
  "build": {
    "system": "direct",
    "linear_memory": {
      "maximum_bytes": 1048576,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "sources": [
        "main.c",
        "raster.c",
        "palette.c",
        "font.c",
        "assets.c",
        "sprites.c",
        "raycast.c",
        "world.c",
        "render.c",
        "input.c",
        "audio.c"
      ],
      "services": [
        "surface",
        "audio",
        "clock",
        "permission",
        "window",
        "log",
        {"name": "ui", "features": ["canvas"]}
      ]
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "release_sequence": 4
}
