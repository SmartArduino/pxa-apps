{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-maze-evil",
  "version": "0.1.13+pxa07",
  "name": "Maze Evil",
  "description": "第一人称迷宫射击游戏，使用触摸移动与转向，包含武器、敌人和音效。优化了输入与音效调度，体验仍取决于实际设备。",
  "build": {
    "system": "cmake",
    "linear_memory": {
      "maximum_bytes": 1048576,
      "pinned": true
    },
    "source_dir": "."
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "surface",
        {
          "name": "audio",
          "min_version": [
            0,
            10
          ]
        },
        "clock",
        "permission",
        "window",
        "log",
        "ui"
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": []
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "release_sequence": 14
}
