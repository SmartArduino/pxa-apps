{
  "format": "pxa-package-source-0.2",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "id": "pxa-quake2",
  "version": "0.2.1",
  "name": "Quake II",
  "description": "Quake II engine with automatically installed original demo media and app-private saves",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 10682368,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "surface",
        "audio",
        "clock",
        "permission",
        "window",
        "log",
        "ui",
        {
          "name": "fs",
          "min_version": [
            0,
            3
          ],
          "features": [
            "app-media-root",
            "read-at",
            "scoped-roots"
          ]
        }
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      },
      "artifact": "aot"
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "release_sequence": 201,
  "resources": {
    "manifest_sha256": "9fe96ab12e6920cfdebd029125c79d9924102426bac13f1d220ac86a027b2492"
  },
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "icon": "assets/icon.png"
}
