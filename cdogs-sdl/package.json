{
  "format": "pxa-package-source-0.2",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "id": "pxa-cdogs-sdl",
  "version": "0.1.0",
  "name": "C-Dogs SDL",
  "description": "开源俯视角动作射击游戏，离线战役、手柄操作与原版音乐。",
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "release_sequence": 1,
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 29360128,
      "pinned": true
    },
    "native_stack_checks": true
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "execution_model": "main-loop",
      "artifact": "aot",
      "services": [
        "surface",
        "clock",
        "window",
        "ui",
        "log",
        "permission",
        {
          "name": "audio",
          "min_version": [
            0,
            10
          ]
        },
        {
          "name": "fs",
          "min_version": [
            0,
            3
          ],
          "features": [
            "read-at",
            "scoped-roots"
          ]
        },
        "assets"
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "icon": "assets/icon.png"
}
