{
  "format": "pxa-package-source-0.2",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "id": "pxa-mindustry",
  "version": "0.11.0",
  "name": "Mindustry · PXA",
  "description": "非官方 C++ 重制：校正全部建筑图标图层、工厂四向出入口、原版音乐音效、视角跟随、Alpha 建造、生产供电、部队和波次防御。",
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "release_sequence": 12,
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 3145728,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "execution_model": "main-loop",
      "artifact": "aot",
      "services": [
        "surface",
        "clock",
        "window",
        {
          "name": "ui",
          "min_version": [
            0,
            10
          ],
          "features": [
            "canvas",
            "font-glyph",
            "sized-text"
          ]
        },
        "log",
        "storage",
        "permission",
        {
          "name": "audio",
          "min_version": [
            0,
            10
          ]
        },
        {
          "name": "assets",
          "min_version": [
            2,
            5
          ]
        },
        {
          "name": "game-render",
          "min_version": [
            1,
            0
          ]
        }
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "random",
          "wall-clock"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "icon": "assets/icon.png"
}
