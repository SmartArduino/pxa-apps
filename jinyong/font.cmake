# Build cooperative font dependencies from source with the active WASI toolchain.
set(FT_DISABLE_ZLIB ON CACHE BOOL "" FORCE)
set(FT_DISABLE_BZIP2 ON CACHE BOOL "" FORCE)
set(FT_DISABLE_PNG ON CACHE BOOL "" FORCE)
set(FT_DISABLE_HARFBUZZ ON CACHE BOOL "" FORCE)
set(FT_DISABLE_BROTLI ON CACHE BOOL "" FORCE)
set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
set(JY_FT "${CMAKE_CURRENT_LIST_DIR}/deps/font/prepared/freetype-2.13.2-cooperative")
add_subdirectory("${JY_FT}" "${CMAKE_CURRENT_BINARY_DIR}/freetype")
target_compile_definitions(freetype PRIVATE JY_COOPERATIVE_FT=1 "FT_CONFIG_MODULES_H=\"jy_ft_modules.h\"")
target_compile_options(freetype PRIVATE -Oz -fno-strict-aliasing -fno-optimize-sibling-calls -ffunction-sections -fdata-sections)
target_include_directories(freetype PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}/deps/font")
set_source_files_properties("${JY_FT}/src/base/ftsystem.c" TARGET_DIRECTORY freetype
 PROPERTIES COMPILE_OPTIONS "-include;${CMAKE_CURRENT_SOURCE_DIR}/fs/jy_fs_redirect.h")
add_library(jy_ttf STATIC deps/font/vendor/SDL_ttf-2.0.11-git/SDL_ttf.c)
target_include_directories(jy_ttf PUBLIC compat/SDL deps/font/vendor/SDL_ttf-2.0.11-git PRIVATE . deps/font)
target_link_libraries(jy_ttf PUBLIC freetype)
target_compile_definitions(jy_ttf PRIVATE JY_COOPERATIVE_FT=1)
target_compile_options(jy_ttf PRIVATE -Oz -fno-strict-aliasing -fno-optimize-sibling-calls -ffunction-sections -fdata-sections)
add_library(jy_ft_protected STATIC deps/font/jy_ft_protected.c)
target_include_directories(jy_ft_protected PRIVATE . deps/font)
target_compile_definitions(jy_ft_protected PRIVATE JY_COOPERATIVE_FT=1)
target_compile_options(jy_ft_protected PRIVATE -O1 -fno-optimize-sibling-calls -ffunction-sections -fdata-sections)
