{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-game-render-bench",
  "version": "0.1.4",
  "name": "GameRender Bench",
  "description": "Eleven-stage 2D/3D benchmark with low-resolution rendering",
  "build": {
    "system": "cmake",
    "linear_memory": {
      "maximum_bytes": 524288,
      "pinned": true
    },
    "source_dir": "."
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "clock",
        "game-render",
        "log"
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": []
      }
    }
  ],
  "release_sequence": 5
}
