{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-game-render-bench",
  "version": "0.4.1",
  "name": "GameRender Bench",
  "description": "分阶段演示与测量 2D、3D、纹理及低分辨率绘制路径。结果随设备与场景变化，不能仅用提交帧率比较性能。",
  "build": {
    "system": "cmake",
    "linear_memory": {
      "maximum_bytes": 524288,
      "pinned": true
    },
    "source_dir": "."
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "clock",
        "game-render",
        "log"
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": []
      }
    }
  ],
  "release_sequence": 6
}
