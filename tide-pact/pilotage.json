    "sites": [
      ["丰沙尔", -16.907, 32.647, "city", "这处湾里收进沿岸小艇运来的粮食与糖。上岸可进入丰沙尔港区。", [-16.904, 32.637]],
      ["卡马拉德洛布什", -16.976, 32.648, "village", "这处湾背后是陡坡。渔户会趁风小时靠岸晾网。", [-16.980, 32.639]],
      ["里贝拉布拉瓦", -17.063, 32.673, "village", "溪水从山谷下来，海上看得见谷口。当地船工会看着浪落下再靠岸。", [-17.072, 32.664]],
      ["蓬塔杜索尔", -17.100, 32.680, "village", "小镇挤在山坡和海岸之间，靠岸的小艇负责把山里的粮食送往丰沙尔。", [-17.104, 32.672]],
      ["圣克鲁斯", -16.791, 32.689, "village", "从村口沿海向东北就能望见马希库。风从山口来时，船会突然横移。", [-16.785, 32.680]],
      ["马希库", -16.766, 32.717, "city", "马希库是早期定居点，湾口外头有浪。关于码头地契，可回丰沙尔找商会。", [-16.752, 32.711]],
      ["卡列塔", -17.173, 32.721, "village", "马德拉较早有人定居的海岸之一。沿海小道顺着斜坡通往谷地。", [-17.172, 32.709]]
    ]
  },
