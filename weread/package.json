{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "id": "pxa-weread",
  "version": "0.1.9+pxa09",
  "release_sequence": 11,
  "name": "微信读书",
  "description": "PXA 原生微信读书客户端，独立扫码登录、书架与专注阅读。非腾讯官方客户端。",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 2097152,
      "pinned": false
    },
    "native_stack_checks": true
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "services": [
        {
          "name": "ui",
          "min_version": [0, 9],
          "features": [
            "dynamic-text",
            "sized-text",
            "text-input-control"
          ]
        },
        {"name": "window", "min_version": [0, 3]},
        {"name": "net", "min_version": [0, 4]},
        {
          "name": "assets",
          "min_version": [2, 3],
          "features": [
            "image-decode"
          ]
        },
        {"name": "fs", "min_version": [0, 4]},
        "permission",
        "clock",
        "log"
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "random",
          "wall-clock"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "net.client",
      "scope": "web",
      "required": false
    }
  ],
  "icon": "assets/icon.png"
}
