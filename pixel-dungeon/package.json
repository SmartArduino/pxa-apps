{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    1,
    0
  ],
  "target_sdk": [
    1,
    0
  ],
  "compile_sdk": [
    1,
    0
  ],
  "id": "pxa-pixel-dungeon",
  "version": "0.2.2",
  "name": "Pixel Dungeon",
  "description": "Turn-based roguelike dungeon crawler drawn with the GameRender raster API and Shattered Pixel Dungeon art",
  "icon": "assets/icon.png",
  "build": {
    "system": "direct",
    "linear_memory": {
      "maximum_bytes": 1048576,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "artifact": "aot",
      "sources": [
        "main.c",
        "game.c",
        "dungeon.c",
        "render.c",
        "input.c",
        "layout.c",
        "font.c",
        "assets.c",
        "compat.c",
        "audio.c",
        "strings.c",
        "font_data.c"
      ],
      "services": [
        "window",
        "game-render",
        "storage",
        "log",
        "audio",
        "clock",
        "permission",
        {
          "name": "ui",
          "features": [
            "canvas"
          ]
        },
        "assets"
      ]
    }
  ],
  "release_sequence": 3,
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ]
}
