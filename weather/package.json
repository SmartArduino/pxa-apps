{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-weather",
  "version": "0.3.7+pxa07",
  "release_sequence": 10,
  "name": "Weather",
  "description": "通过 IP 定位显示当地天气，支持自动切换数据提供方。无需 API key；定位精度与数据可用性取决于网络，不能代替专业预警。",
  "icon": "assets/icon.png",
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": []
      }
    }
  ],
  "services": [
    "net",
    "storage",
    "clock",
    "permission",
    "window",
    {
      "name": "ui"
    },
    "assets",
    "log"
  ],
  "permissions": [
    {
      "name": "net.client",
      "required": false,
      "scope": "https://air-quality-api.open-meteo.com"
    },
    {
      "name": "net.client",
      "required": false,
      "scope": "https://api.open-meteo.com"
    },
    {
      "name": "net.client",
      "required": false,
      "scope": "https://archive-api.open-meteo.com"
    },
    {
      "name": "net.client",
      "required": false,
      "scope": "https://geocoding-api.open-meteo.com"
    },
    {
      "name": "net.client",
      "required": false,
      "scope": "https://ipapi.co"
    },
    {
      "name": "net.client",
      "required": false,
      "scope": "https://ipwho.is"
    },
    {
      "name": "net.client",
      "required": false,
      "scope": "https://wttr.in"
    }
  ],
  "build": {
    "system": "cmake",
    "source_dir": "."
  }
}
