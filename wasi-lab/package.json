{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-wasi-lab",
  "version": "0.1.4",
  "release_sequence": 5,
  "name": "PXA WASI Lab",
  "description": "检查 WASI libc、时钟与随机数能力，查看设备运行结果。面向开发者的 Core 2 诊断示例。",
  "build": {
    "system": "cmake",
    "source_dir": "."
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "window",
        "ui"
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "random",
          "wall-clock"
        ]
      }
    }
  ]
}
