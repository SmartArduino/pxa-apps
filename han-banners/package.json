{
  "format": "pxa-package-source-0.2",
  "id": "pxa-han-banners",
  "name": "三国逐城",
  "version": "1.4.0",
  "release_sequence": 9,
  "description": "原创三国策略。三个历史剧本、四十八城。搜索物资和在野人才，参与州郡军略、季末军议、跨季围城、临阵号令和战后招降。",
  "icon": "assets/icon.png",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        {
          "name": "clock",
          "min_version": [
            0,
            3
          ]
        },
        {
          "name": "window",
          "min_version": [
            0,
            3
          ]
        },
        {
          "name": "ui",
          "min_version": [
            0,
            9
          ]
        },
        {
          "name": "game-render",
          "min_version": [
            1,
            5
          ]
        },
        {
          "name": "assets",
          "min_version": [
            2,
            2
          ]
        },
        "storage",
        "log"
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      }
    }
  ],
  "build": {
    "system": "cmake",
    "linear_memory": {
      "maximum_bytes": 2097152,
      "pinned": false
    }
  },
  "interaction": {
    "schema": "pxa-app-interaction-1",
    "profiles": [
      {
        "id": "touch",
        "kind": "touch",
        "complete": true,
        "contacts": 1,
        "requires": {
          "tap": "tap"
        }
      },
      {
        "id": "gamepad",
        "kind": "controller",
        "complete": true,
        "requires": {
          "up": "tap",
          "down": "tap",
          "left": "tap",
          "right": "tap",
          "a": "tap",
          "b": "tap"
        }
      }
    ]
  }
}
