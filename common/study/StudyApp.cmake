cmake_minimum_required(VERSION 3.20)
set(PXA_COROUTINE_SLOT_BYTES 4096)
list(APPEND CMAKE_MODULE_PATH "${PXA_CMAKE_MODULE_DIR}")
include(PxaGuest)
pxa_add_app(pxa_main COMPONENT_ID main SOURCES "${CMAKE_CURRENT_LIST_DIR}/app.cpp")
target_include_directories(pxa_main PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
target_compile_definitions(pxa_main PRIVATE STUDY_KIND=${STUDY_KIND} STUDY_AGE=${STUDY_AGE})
target_compile_options(pxa_main PRIVATE -Oz)
target_link_options(pxa_main PRIVATE -Wl,-z,stack-size=65536)
