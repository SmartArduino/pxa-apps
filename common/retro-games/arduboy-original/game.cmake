# Independent C++ game linked through existing PXA C guest ABI; no SDK changes.
list(APPEND CMAKE_MODULE_PATH "${PXA_CMAKE_MODULE_DIR}")
# The sketch uses C++17 and the C ABI, not the optional C++26 PXA service wrapper.
set(PXA_CPP_SDK_DIR "")
include("${CMAKE_CURRENT_LIST_DIR}/../Build.cmake")
include_directories("${CMAKE_CURRENT_LIST_DIR}/..")
set(ARDU_PXA_ROOT "${CMAKE_CURRENT_LIST_DIR}")
if(ARDU_GAME STREQUAL "ardudash")
 set(ARDU_GAME_ID 1)
elseif(ARDU_GAME STREQUAL "ardubreakout")
 set(ARDU_GAME_ID 2)
elseif(ARDU_GAME STREQUAL "prototype")
 set(ARDU_GAME_ID 0)
else()
 message(FATAL_ERROR "Unknown independent Arduboy game")
endif()
set(ARDU_PROVIDER_SOURCES "${ARDU_PXA_ROOT}/../arduboy-batch-20261010/compat.cpp")
foreach(name Arduboy2 Arduboy2Data Arduboy2Audio Arduboy2Beep Sprites SpritesB)
 list(APPEND ARDU_PROVIDER_SOURCES "${ARDU_PXA_ROOT}/../arduboy-batch-20261010/vendor/platform/${name}.cpp")
endforeach()
pxa_retro_component(pxa_main COMPONENT_ID main SOURCES "${ARDU_PXA_ROOT}/frontend.cpp" ${ARDU_PROVIDER_SOURCES} "${CMAKE_CURRENT_SOURCE_DIR}/game.cpp" INCLUDE_DIRS "${ARDU_PXA_ROOT}/../arduboy-batch-20261010" "${ARDU_PXA_ROOT}" "${ARDU_PXA_ROOT}/../arduboy-batch-20261010/vendor/platform")
target_compile_features(pxa_main PRIVATE cxx_std_17)
target_compile_definitions(pxa_main PRIVATE ARDU_GAME_ID=${ARDU_GAME_ID} ARDUBOY_CORE)
target_compile_options(pxa_main PRIVATE -fno-exceptions -fno-rtti -fno-strict-aliasing -ffunction-sections -fdata-sections)
target_link_options(pxa_main PRIVATE -Wl,--gc-sections -Wl,-z,stack-size=131072 -Wl,--export=malloc -Wl,--export=free -Wl,--wrap=__assert_fail -Wl,--wrap=abort -Wl,--wrap=exit)
