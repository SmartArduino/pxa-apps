list(APPEND CMAKE_MODULE_PATH "${PXA_CMAKE_MODULE_DIR}")
include("${CMAKE_CURRENT_LIST_DIR}/../Build.cmake")
include_directories("${CMAKE_CURRENT_LIST_DIR}/..")
set(PZ_ROOT "${CMAKE_CURRENT_LIST_DIR}")
set(PZ_ORIGINAL "${PZ_ROOT}/../puzzles")
if(NOT PXA_PUZZLE MATCHES "^(filling|keen|solo|towers|unequal|undead)$")
  message(FATAL_ERROR "Unknown keypad puzzle backend")
endif()
set(PZ_CORE midend drawing misc malloc random tree234 dsf findloop sort combi version)
set(PZ_SOURCES)
foreach(PZ_UNIT IN LISTS PZ_CORE)
  list(APPEND PZ_SOURCES "${PZ_ORIGINAL}/vendor/${PZ_UNIT}.c")
endforeach()
# Original extra solver dependencies; never alter original backend files.
set(PZ_EXTRA)
if(PXA_PUZZLE MATCHES "^(keen|towers|unequal)$")
  set(PZ_EXTRA latin matching)
elseif(PXA_PUZZLE STREQUAL "solo")
  set(PZ_EXTRA divvy)
endif()
foreach(PZ_UNIT IN LISTS PZ_EXTRA)
  list(APPEND PZ_SOURCES "${PZ_ORIGINAL}/vendor/${PZ_UNIT}.c")
endforeach()
pxa_retro_component(pxa_main COMPONENT_ID main
  SOURCES "${PZ_ROOT}/frontend.c" "${PZ_ORIGINAL}/compat.c" "${PZ_ORIGINAL}/vendor/${PXA_PUZZLE}.c" ${PZ_SOURCES}
  INCLUDE_DIRS "${PZ_ROOT}" "${PZ_ORIGINAL}" "${PZ_ORIGINAL}/vendor")
target_compile_definitions(pxa_main PRIVATE NO_TGMATH_H PXA_RETRO_KEYPAD=1)
target_compile_options(pxa_main PRIVATE -ffunction-sections -fdata-sections)
target_link_options(pxa_main PRIVATE -Wl,--gc-sections -Wl,-z,stack-size=524288
  -Wl,--export=malloc -Wl,--export=free -Wl,--wrap=getenv -Wl,--wrap=__assert_fail -Wl,--wrap=abort -Wl,--wrap=exit
  -Wl,--wrap=__wasi_fd_close -Wl,--wrap=__wasi_fd_seek -Wl,--wrap=__wasi_fd_write)
