list(APPEND CMAKE_MODULE_PATH "${PXA_CMAKE_MODULE_DIR}")
include("${CMAKE_CURRENT_LIST_DIR}/../Build.cmake")
include_directories("${CMAKE_CURRENT_LIST_DIR}/..")
set(SAF_STANDALONE_ROOT "${CMAKE_CURRENT_LIST_DIR}")
if(SAF_GAME STREQUAL "microtd")
  set(SAF_ENTRY_ID 1)
elseif(SAF_GAME STREQUAL "chess")
  set(SAF_ENTRY_ID 3)
else()
  message(FATAL_ERROR "Unknown original standalone SAF game")
endif()
pxa_retro_component(pxa_main COMPONENT_ID main SOURCES "${SAF_STANDALONE_ROOT}/frontend.c" INCLUDE_DIRS "${SAF_STANDALONE_ROOT}")
target_compile_definitions(pxa_main PRIVATE SAF_ENTRY_ID=${SAF_ENTRY_ID})
target_compile_options(pxa_main PRIVATE -fno-strict-aliasing -ffunction-sections -fdata-sections)
target_link_options(pxa_main PRIVATE -Wl,--gc-sections -Wl,-z,stack-size=131072
  -Wl,--export=malloc -Wl,--export=free -Wl,--wrap=__assert_fail -Wl,--wrap=abort -Wl,--wrap=exit)
