list(APPEND CMAKE_MODULE_PATH "${PXA_CMAKE_MODULE_DIR}")
include("${CMAKE_CURRENT_LIST_DIR}/../Build.cmake")
include_directories("${CMAKE_CURRENT_LIST_DIR}/..")
set(SAF_ROOT "${CMAKE_CURRENT_LIST_DIR}")
if(SAF_GAME STREQUAL "snek")
  set(SAF_GAME_ID 0)
elseif(SAF_GAME STREQUAL "bloq")
  set(SAF_GAME_ID 2)
elseif(SAF_GAME STREQUAL "runr")
  set(SAF_GAME_ID 4)
else()
  message(FATAL_ERROR "Unknown original SAF minigame")
endif()
pxa_retro_component(pxa_main COMPONENT_ID main SOURCES "${SAF_ROOT}/frontend.c" INCLUDE_DIRS "${SAF_ROOT}")
target_compile_definitions(pxa_main PRIVATE SAF_GAME_ID=${SAF_GAME_ID})
target_compile_options(pxa_main PRIVATE -fno-strict-aliasing -ffunction-sections -fdata-sections)
target_link_options(pxa_main PRIVATE -Wl,--gc-sections -Wl,-z,stack-size=131072
  -Wl,--export=malloc -Wl,--export=free -Wl,--wrap=__assert_fail -Wl,--wrap=abort -Wl,--wrap=exit)
