# Shared PXA console frontend. Include after the platform's engine.cmake.
get_filename_component(EMU_COMMON "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
set(EMU_FRONTEND ${EMU_COMMON}/main.c ${EMU_COMMON}/audio.c
    ${EMU_COMMON}/video_renderer.c ${EMU_COMMON}/controls.c
    ${EMU_COMMON}/font8x8.c ${EMU_COMMON}/ui_font.c ${EMU_COMMON}/emu_profile.c)
set(EMU_CORE ${EMU_ENGINE_SOURCES} ${EMU_COMMON}/core_util.c ${EMU_COMMON}/../rom/rom_cache.c)
if(EMU_NATIVE_TEST)
    enable_testing()
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    add_library(emu_core STATIC ${EMU_CORE})
    target_include_directories(emu_core PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}" "${EMU_COMMON}" ${EMU_ENGINE_INCLUDES})
    target_compile_definitions(emu_core PUBLIC ${EMU_ENGINE_DEFINITIONS})
    target_compile_options(emu_core PRIVATE -O3 -fno-strict-aliasing -UNDEBUG)
    target_link_libraries(emu_core PUBLIC m)
    if(EMU_SYSTEM STREQUAL "sms" OR EMU_SYSTEM STREQUAL "gg" OR EMU_SYSTEM STREQUAL "pce" OR EMU_SYSTEM STREQUAL "snes" OR EMU_SYSTEM STREQUAL "md")
        add_executable(emu_state_test ${EMU_COMMON}/tests/state_test.c)
        target_link_libraries(emu_state_test PRIVATE emu_core)
        target_compile_options(emu_state_test PRIVATE -UNDEBUG)
        add_test(NAME emu_state COMMAND emu_state_test "${CMAKE_CURRENT_BINARY_DIR}/test.rom")
    endif()
    add_executable(emu_core_test ${EMU_COMMON}/tests/core_test.c)
    target_link_libraries(emu_core_test PRIVATE emu_core)
    if(DEFINED EMU_TEST_BLUE)
        target_compile_definitions(emu_core_test PRIVATE EMU_TEST_BLUE=${EMU_TEST_BLUE})
    endif()
    target_compile_options(emu_core_test PRIVATE -UNDEBUG)
    add_executable(emu_dump_video ${EMU_COMMON}/tests/dump_video.c)
    target_link_libraries(emu_dump_video PRIVATE emu_core)
    add_executable(emu_benchmark ${EMU_COMMON}/tests/benchmark.c)
    target_link_libraries(emu_benchmark PRIVATE emu_core)
    if(EMU_SYSTEM STREQUAL "sms" OR EMU_SYSTEM STREQUAL "gg" OR EMU_SYSTEM STREQUAL "pce" OR EMU_SYSTEM STREQUAL "snes" OR EMU_SYSTEM STREQUAL "md")
        add_executable(emu_paging_test ${EMU_COMMON}/tests/paging_test.c)
        target_link_libraries(emu_paging_test PRIVATE emu_core)
        target_compile_options(emu_paging_test PRIVATE -UNDEBUG)
        if(EMU_SYSTEM STREQUAL "md")
            target_compile_definitions(emu_paging_test PRIVATE EMU_PAGING_MD=1)
        endif()
        if(EMU_SYSTEM STREQUAL "snes")
            target_compile_definitions(emu_paging_test PRIVATE EMU_PAGING_SNES=1)
        endif()
        if(EMU_SYSTEM STREQUAL "pce")
            target_compile_definitions(emu_paging_test PRIVATE EMU_PAGING_PCE=1)
        endif()
        add_test(NAME emu_paging COMMAND emu_paging_test "${CMAKE_CURRENT_BINARY_DIR}/test.rom")
    endif()
    add_custom_command(OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/test.rom"
        COMMAND "${Python3_EXECUTABLE}" "${EMU_COMMON}/tests/make_test_rom.py" "${EMU_SYSTEM}" "${CMAKE_CURRENT_BINARY_DIR}/test.rom"
        DEPENDS "${EMU_COMMON}/tests/make_test_rom.py")
    add_custom_target(emu_test_rom ALL DEPENDS "${CMAKE_CURRENT_BINARY_DIR}/test.rom")
    if(EMU_SYSTEM STREQUAL "sms" OR EMU_SYSTEM STREQUAL "gg")
        add_executable(emu_tile_test ${EMU_COMMON}/tests/tile_test.c)
        target_link_libraries(emu_tile_test PRIVATE emu_core)
        target_compile_options(emu_tile_test PRIVATE -UNDEBUG -fno-strict-aliasing)
        add_test(NAME emu_tile COMMAND emu_tile_test "${CMAKE_CURRENT_BINARY_DIR}/test.rom")
        add_executable(emu_z80_test ${EMU_COMMON}/tests/z80_test.c)
        target_link_libraries(emu_z80_test PRIVATE emu_core)
        target_compile_options(emu_z80_test PRIVATE -UNDEBUG)
        add_test(NAME emu_z80 COMMAND emu_z80_test "${CMAKE_CURRENT_BINARY_DIR}/test.rom")
    endif()
    add_test(NAME emu_core COMMAND emu_core_test "${CMAKE_CURRENT_BINARY_DIR}/test.rom")
    foreach(name controls video audio)
        set(extra)
        if(name STREQUAL "audio")
            set(extra ${EMU_COMMON}/audio.c)
        else()
            set(extra ${EMU_COMMON}/video_renderer.c ${EMU_COMMON}/controls.c ${EMU_COMMON}/font8x8.c)
        endif()
        add_executable(emu_${name}_test ${EMU_COMMON}/tests/${name}_test.c ${extra})
        target_link_libraries(emu_${name}_test PRIVATE emu_core)
        target_compile_options(emu_${name}_test PRIVATE -UNDEBUG)
        add_test(NAME emu_${name} COMMAND emu_${name}_test)
    endforeach()

    if(EMU_GUEST_SDK_INCLUDE)
        list(APPEND CMAKE_MODULE_PATH "${EMU_GUEST_SDK_INCLUDE}/../../cmake")
        get_filename_component(PXA_GUEST_SDK_DIR "${EMU_GUEST_SDK_INCLUDE}/.." ABSOLUTE)
        set(PXA_ARTIFACT_DIR "${CMAKE_CURRENT_BINARY_DIR}/artifacts")
        include(PxaGuest)
        add_executable(emu_state_slots_test ${EMU_COMMON}/tests/state_slots_test.c)
        target_include_directories(emu_state_slots_test PRIVATE "${EMU_GUEST_SDK_INCLUDE}")
        target_compile_options(emu_state_slots_test PRIVATE -UNDEBUG -Wno-attributes)
        add_test(NAME emu_state_slots COMMAND emu_state_slots_test)
        add_executable(emu_frontend_test ${EMU_COMMON}/tests/frontend_test.c ${EMU_FRONTEND})
        # main.c is included by the test so private state can be inspected.
        get_target_property(sources emu_frontend_test SOURCES)
        list(REMOVE_ITEM sources ${EMU_COMMON}/main.c)
        set_property(TARGET emu_frontend_test PROPERTY SOURCES ${sources})
        target_link_libraries(emu_frontend_test PRIVATE emu_core)
        pxa_add_translations(emu_frontend_test SOURCE "${CMAKE_CURRENT_SOURCE_DIR}/i18n/messages.yaml" LANGUAGE c)
        target_include_directories(emu_frontend_test PRIVATE "${CMAKE_CURRENT_BINARY_DIR}" "${EMU_GUEST_SDK_INCLUDE}")
        target_compile_definitions(emu_frontend_test PRIVATE EMU_APP_VERSION="test")
        target_compile_options(emu_frontend_test PRIVATE -UNDEBUG -Wno-attributes)
        add_test(NAME emu_frontend COMMAND emu_frontend_test)
    endif()
else()
    list(APPEND CMAKE_MODULE_PATH "${PXA_CMAKE_MODULE_DIR}")
    include(PxaGuest)
    pxa_add_component(pxa_main COMPONENT_ID main SOURCES ${EMU_FRONTEND} ${EMU_CORE})
    target_include_directories(pxa_main PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}" "${EMU_COMMON}" "${CMAKE_CURRENT_BINARY_DIR}" ${EMU_ENGINE_INCLUDES})
    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/package.json" EMU_PACKAGE_JSON)
    string(JSON EMU_VERSION GET "${EMU_PACKAGE_JSON}" version)
    string(JSON EMU_MEMORY_BYTES GET "${EMU_PACKAGE_JSON}" build linear_memory maximum_bytes)
    target_compile_definitions(pxa_main PRIVATE ${EMU_ENGINE_DEFINITIONS} PXA_GUEST)
    # Version strings belong to the frontend. Updating package metadata must
    # not invalidate every object in large third-party CPU/PPU cores.
    set_source_files_properties(${EMU_COMMON}/main.c PROPERTIES
        COMPILE_DEFINITIONS "EMU_APP_VERSION=\"${EMU_VERSION}\"")
    target_compile_options(pxa_main PRIVATE -O3 -flto -fno-strict-aliasing)
    target_link_options(pxa_main PRIVATE -flto "-Wl,--initial-memory=${EMU_MEMORY_BYTES}")
endif()
