{
  "format": "pxa-package-source-0.2",
  "id": "pxa-iron-dawn",
  "version": "1.2.0",
  "release_sequence": 3,
  "name": "钢铁黎明",
  "description": "原创等距即时战略。采矿建造、装甲编队、战争迷雾与三章故事战役，在灰烬中夺回黎明。",
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "icon": "assets/icon.png",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 4194304,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "artifact": "aot",
      "services": [
        "surface",
        "clock",
        "storage",
        "window",
        "log",
        "ui",
        "audio",
        "permission",
        "fs"
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ]
}
