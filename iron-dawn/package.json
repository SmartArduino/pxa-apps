{
  "format": "pxa-package-source-0.2",
  "id": "pxa-iron-dawn",
  "version": "1.13.3",
  "release_sequence": 22,
  "name": "钢铁黎明",
  "description": "原创像素即时战略。北境联军与灰塔守备军拥有不同装甲、空军和建筑，包含八章战役与双阵营无尽守备，含河谷、海防和山岭三张守备战场，支持双人局域网合作守备。",
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "icon": "assets/icon.png",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 4194304,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "artifact": "aot",
      "services": [
        "surface",
        "clock",
        "storage",
        "window",
        "log",
        "ui",
        "audio",
        "permission",
        "fs",
        "assets",
        "net"
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    },
    {
      "name": "net.listen",
      "required": false,
      "scope": "local-network"
    },
    {
      "name": "net.socket",
      "required": false,
      "scope": "outbound"
    }
  ]
}
