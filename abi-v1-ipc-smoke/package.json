{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-abi-v1-ipc-smoke",
  "version": "1.0.1",
  "name": "Core 2 IPC Smoke",
  "description": "Exercises Core 2 IPC across two signed Components",
  "build": {
    "system": "cmake",
    "linear_memory": {
      "maximum_bytes": 131072,
      "pinned": false
    },
    "source_dir": "."
  },
  "components": [
    {
      "id": "echo",
      "kind": "service",
      "services": [
        "ipc"
      ],
      "cmake_target": "pxa_echo",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": []
      }
    },
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "ipc",
        "log"
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": []
      }
    }
  ],
  "ipc_endpoints": [
    {
      "name": "core2.echo",
      "component": "echo"
    }
  ],
  "release_sequence": 2
}
