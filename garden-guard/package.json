{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-garden-guard",
  "version": "0.2.4",
  "release_sequence": 5,
  "name": "Garden Guard",
  "description": "在昼夜花园中布置植物抵御敌人，包含 12 个关卡与 13 种植物。选择植物、管理资源并保护花园。",
  "icon": "assets/icon.png",
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "audio",
        "clock",
        "permission",
        "storage",
        "window",
        {
          "name": "ui",
          "features": [
            "canvas"
          ]
        }
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": []
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "build": {
    "system": "cmake",
    "source_dir": "."
  }
}
