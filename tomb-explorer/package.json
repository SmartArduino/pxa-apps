{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-tomb-explorer",
  "version": "0.1.5",
  "name": "Tomb Explorer",
  "description": "第三人称房间与门洞探索游戏，使用纹理多边形绘制。通过触摸控制角色与视角，在古墓空间中探索。",
  "build": {
    "system": "cmake",
    "linear_memory": {
      "maximum_bytes": 1048576,
      "pinned": true
    },
    "source_dir": "."
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "window",
        "ui",
        "clock",
        "game-render",
        "log"
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": []
      }
    }
  ],
  "release_sequence": 6
}
