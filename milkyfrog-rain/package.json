{
  "format": "pxa-package-source-0.2",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "id": "pxa-milkyfrog-rain",
  "version": "0.1.7",
  "name": "奶蛙的奶块雨",
  "description": "左右移动接奶块，五连击触发大笑清屏，保留原版笑声与音效。",
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "release_sequence": 8,
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 2097152,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "execution_model": "main-loop",
      "artifact": "aot",
      "services": [
        "surface",
        "clock",
        "window",
        {
          "name": "ui",
          "min_version": [
            0,
            6
          ],
          "features": [
            "canvas",
            "sized-text"
          ]
        },
        "log",
        "storage",
        "permission",
        {
          "name": "audio",
          "min_version": [
            0,
            10
          ]
        },
        {
          "name": "assets",
          "min_version": [
            2,
            5
          ]
        }
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "icon": "assets/icon.png"
}
