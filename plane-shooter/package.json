{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-plane-shooter",
  "version": "0.3.3",
  "release_sequence": 7,
  "name": "Orbital Strike",
  "description": "太空射击游戏，提供剧情关卡、机库和自动开火。通过触摸移动战机，躲避弹幕并挑战敌人。",
  "icon": "assets/plane-shooter/icon.png",
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "audio",
        "clock",
        "permission",
        "storage",
        "window",
        {
          "name": "ui",
          "features": [
            "canvas"
          ]
        },
        "assets",
        "log"
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": []
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "build": {
    "system": "cmake",
    "source_dir": "."
  }
}
