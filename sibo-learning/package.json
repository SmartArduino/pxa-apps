{
  "format": "pxa-package-source-0.2",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "id": "pxa-sibo-learning",
  "version": "0.7.0",
  "release_sequence": 14,
  "name": "四博学习宝",
  "description": "诗词、故事、英语词卡、同步教材、科学图文与离线数学动手玩：4×4数独、24点和分数练习。支持触摸、三按键及学习进度保存，无需SD卡。",
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "icon": "assets/icon.png",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 4194304,
      "pinned": false
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "artifact": "aot",
      "services": [
        {
          "name": "ui",
          "min_version": [
            0,
            9
          ]
        },
        {
          "name": "window",
          "min_version": [
            0,
            3
          ]
        },
        "clock",
        "storage",
        {
          "name": "fs",
          "min_version": [
            0,
            2
          ]
        },
        "permission",
        "log",
        {
          "name": "net",
          "min_version": [
            0,
            5
          ]
        },
        {
          "name": "audio",
          "min_version": [
            0,
            10
          ]
        },
        {
          "name": "assets",
          "min_version": [
            2,
            2
          ]
        }
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "random",
          "wall-clock"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "scope": "media",
      "required": false
    },
    {
      "name": "net.client",
      "scope": "web",
      "required": false
    }
  ]
}
