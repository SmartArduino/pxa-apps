{
  "format": "pxa-package-source-0.2",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "id": "pxa-marble-islands",
  "version": "1.7.1",
  "name": "Marble Islands",
  "description": "软件3D滚珠群岛，支持陀螺仪融合体感、触屏与手柄，含姿态校准、灵敏度与方向设置。",
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "release_sequence": 12,
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 2097152,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "execution_model": "main-loop",
      "artifact": "aot",
      "services": [
        "surface",
        "clock",
        "window",
        "ui",
        "log",
        "storage",
        "permission",
        {
          "name": "audio",
          "min_version": [
            0,
            10
          ]
        },
        {
          "name": "sensor",
          "min_version": [
            0,
            1
          ]
        }
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    },
    {
      "name": "sensor.read",
      "scope": "motion.acceleration",
      "required": false
    },
    {
      "name": "sensor.read",
      "scope": "motion.angular-velocity",
      "required": false
    }
  ],
  "icon": "assets/icon.png"
}
