{
  "format": "pxa-package-source-0.2",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "id": "pxa-openlara",
  "version": "0.7.11",
  "name": "OpenLara",
  "description": "OpenLara with automatically installed original PC demo media and app-private saves",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 9437184,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "surface",
        "clock",
        "window",
        "ui",
        "log",
        {
          "name": "fs",
          "min_version": [
            0,
            3
          ],
          "features": [
            "app-media-root",
            "scoped-roots"
          ]
        },
        {
          "name": "audio",
          "min_version": [
            0,
            10
          ]
        },
        "permission"
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      },
      "artifact": "aot"
    }
  ],
  "release_sequence": 213,
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "icon": "assets/icon.png",
