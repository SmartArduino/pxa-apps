{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    1,
    0
  ],
  "target_sdk": [
    1,
    0
  ],
  "compile_sdk": [
    1,
    0
  ],
  "id": "pxa-voxel-craft",
  "version": "0.2.0",
  "release_sequence": 5,
  "name": "Voxel Craft",
  "description": "First-person voxel sandbox: mine blocks, build structures, fight slimes, walk and fly",
  "icon": "assets/icon.png",
  "build": {
    "system": "direct",
    "linear_memory": {
      "maximum_bytes": 1572864,
      "pinned": false
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "sources": [
        "main.c",
        "game.c",
        "render.c",
        "block_textures.c",
        "voxel_raster.c",
        "voxel_assets.c"
      ],
      "services": [
        "audio",
        {
          "name": "game-render",
          "features": [
            "asset-bindings"
          ]
        },
        "log",
        "storage",
        "clock",
        "window",
        "permission",
        {
          "name": "ui",
          "features": [
            "canvas"
          ]
        },
        "assets"
      ]
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ]
}
