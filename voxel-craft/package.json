{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-voxel-craft",
  "version": "0.12.9",
  "release_sequence": 22,
  "name": "Voxel Craft",
  "description": "第一人称体素沙盒，支持新游戏、多个存档、背包与合成、挖掘与放置。左侧移动、右侧转向，长按操作键挖掘；工具与材质影响效率和音效。飞行可在设置中开启。",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 2097152,
      "pinned": false
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "services": [
        "window",
        "log",
        "clock",
        "assets",
        "game-render",
        "ui",
        "surface",
        "fs",
        "storage",
        "audio"
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "random",
          "wall-clock"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "scope": "media",
      "required": false
    }
  ],
  "icon": "assets/icon.png"
}
