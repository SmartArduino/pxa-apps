+/* PXA: all original mutable statics encoded fieldwise. */
+void obono_reset_game(){
+ state=0;
+ toDraw=0;
+ gameFrames=0;
+ counter=0;
+ ignoreCnt=0;
+ score=0;
+ level=0;
+ isHiscore=0;
+ playerX=0;
+ playerY=0;
+ playerJump=0;
+ playerTorque=0;
+ playerRotate=0;
+ memset(floorAry,0,sizeof(floorAry));
+ floorIdxFirst=0;
+ floorIdxLast=0;
+ memset(flrTypes,0,sizeof(flrTypes));
+ flrTypesNum=0;
+ pFloorBlur=NULL;
+ memset(chipAry,0,sizeof(chipAry));
+ chipBaseZ=0;
+ isBlink=0;
+}
+void obono_pack_game(ObonoWriter&w){
+ w.u8(state);
+ w.u8(toDraw);
+ w.u32(gameFrames);
+ w.u16(counter);
+ w.u8(ignoreCnt);
+ w.u16(score);
+ w.u16(level);
+ w.u8(isHiscore);
+ w.u16(playerX);
+ w.u16(playerY);
+ w.u8(playerJump);
+ w.u8(playerTorque);
+ w.u8(playerRotate);
+ for(auto&v:floorAry){w.u8(v.type);w.u8(v.pos);w.u16(v.x);w.u16(v.y);w.u16(v.z);w.u16(v.vx);w.u16(v.vy);w.u8(v.size);w.u8(v.sizeBack);}
+ w.u8(floorIdxFirst);
+ w.u8(floorIdxLast);
+ for(auto v:flrTypes)w.u8(v);
+ w.u8(flrTypesNum);
+ w.u8(pFloorBlur?(uint8_t)(pFloorBlur-floorAry):255);
+ for(auto&v:chipAry){w.u16(v.x);w.u16(v.y);}
+ w.u16(chipBaseZ);
+ w.u8(isBlink);
+}
+void obono_register_game(){
+ obono_audio_register(1,soundStart,sizeof(soundStart));
+ obono_audio_register(2,soundJump,sizeof(soundJump));
+ obono_audio_register(3,soundClear,sizeof(soundClear));
+ obono_audio_register(4,soundOver,sizeof(soundOver));
+}
