{
  "format": "pxa-package-source-0.2",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "id": "pxa-nes",
  "version": "0.1.45",
  "release_sequence": 51,
  "name": "NES Emulator",
  "description": "NES emulator with SD/flash ROM library, audio, controllers and independent frame skipping",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 4194304,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "artifact": "aot",
      "services": [
        "surface",
        "window",
        "ui",
        "log",
        "permission",
        "audio",
        {
          "name": "clock",
          "min_version": [
            0,
            2
          ],
          "features": []
        },
        {
          "name": "fs",
          "min_version": [
            0,
            4
          ],
          "features": [
            "app-media-path",
            "app-media-root",
            "read-at"
          ]
        },
        {
          "name": "assets",
          "min_version": [
            2,
            0
          ]
        },
        {
          "name": "game-render",
          "min_version": [
            1,
            0
          ],
          "features": []
        },
        "storage"
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "random",
          "wall-clock"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "icon": "assets/icon.png",
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "resources": {
    "manifest_sha256": "8fd4d67221cc6196439b8366a6e682f3159124e0f23d27ade11b2e189cddb8d1"
  }
}
