{
  "format": "pxa-package-source-0.2",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "id": "pxa-dewfield",
  "version": "0.23.6",
  "name": "晴露农场 Dewfield",
  "description": "四人合作像素农场：局域网创建与发现、IP端口直连、网页加入，四季种植、村民故事和矿洞冒险。",
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "release_sequence": 43,
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 3145728,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "execution_model": "main-loop",
      "artifact": "both",
      "services": [
        "surface",
        "clock",
        "window",
        {
          "name": "ui",
          "min_version": [
            0,
            9
          ]
        },
        "log",
        "storage",
        {
          "name": "game-render",
          "min_version": [
            1,
            0
          ]
        },
        {
          "name": "audio",
          "min_version": [
            0,
            7
          ]
        },
        "permission",
        {
          "name": "net",
          "min_version": [
            0,
            7
          ]
        },
        {
          "name": "assets",
          "min_version": [
            2,
            0
          ]
        }
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "random",
          "wall-clock"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    },
    {
      "name": "net.discovery",
      "scope": "local-network",
      "required": false
    },
    {
      "name": "net.listen",
      "scope": "network",
      "required": false
    },
    {
      "name": "net.socket",
      "scope": "outbound",
      "required": false
    }
  ],
  "icon": "assets/icon.png"
}
