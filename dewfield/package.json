{
  "format": "pxa-package-source-0.2",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "id": "pxa-dewfield",
  "version": "0.13.1",
  "name": "晴露农场 Dewfield",
  "description": "四季农场生活：统一像素角色、工具动作、体力作息、镇上商店、电视天气与季节日历。",
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "release_sequence": 21,
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 3145728,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "execution_model": "main-loop",
      "artifact": "aot",
      "services": [
        "surface",
        "clock",
        "window",
        {
          "name": "ui",
          "min_version": [
            0,
            9
          ]
        },
        "log",
        "storage",
        {
          "name": "game-render",
          "min_version": [
            1,
            0
          ]
        },
        {
          "name": "audio",
          "min_version": [
            0,
            7
          ]
        },
        "permission"
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "random",
          "wall-clock"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "icon": "assets/icon.png"
}
