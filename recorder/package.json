{
  "format": "pxa-package-source-0.2",
  "id": "pxa-recorder",
  "version": "0.1.0",
  "release_sequence": 1,
  "name": "轻录音",
  "description": "简洁的本地录音机，支持暂停续录、Opus 文件保存、录音回放和确认删除，适配触摸与三按键设备。",
  "icon": "assets/icon.png",
  "min_sdk": [2, 1],
  "target_sdk": [2, 1],
  "compile_sdk": [2, 1],
  "publisher": {"handle": "lucinhu", "display_name": "lucinhu"},
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {"maximum_bytes": 1048576, "pinned": false}
  },
  "components": [{
    "id": "main", "kind": "ui", "cmake_target": "pxa_main",
    "services": [
      {"name": "ui", "features": ["canvas", "dynamic-text"], "min_version": [0, 9]},
      {"name": "audio", "min_version": [0, 15]},
      "window", "clock", "permission", {"name": "fs", "min_version": [0, 1]}, "log"
    ],
    "wasi": {"version": "preview1", "libc": "wasi-libc", "features": ["monotonic-clock", "random", "wall-clock"]}
  }],
  "permissions": [
    {"name": "audio.capture", "scope": "microphone", "required": false},
    {"name": "audio.playback", "scope": "media", "required": false}
  ]
}
