{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-plane-shooter-raster",
  "version": "0.1.5",
  "name": "Orbital Strike Raster",
  "description": "太空射击的光栅绘制版本，按设备调整渲染分辨率。触摸移动、自动开火；画面路径与原版不同，适合体验和比较。",
  "build": {
    "system": "cmake",
    "linear_memory": {
      "maximum_bytes": 1048576,
      "pinned": true
    },
    "source_dir": "."
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "window",
        "ui",
        "clock",
        "game-render"
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": []
      }
    }
  ],
  "release_sequence": 6
}
