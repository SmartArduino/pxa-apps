{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-abi-v1-smoke",
  "version": "1.0.1",
  "name": "Core 2 Smoke",
  "description": "Exercises signed Core 2 calls and event delivery",
  "build": {
    "system": "cmake",
    "linear_memory": {
      "maximum_bytes": 131072,
      "pinned": false
    },
    "source_dir": "."
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "log",
        "device",
        "game-render",
        "window",
        "permission",
        "storage",
        "fs",
        "clock",
        "ui"
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": []
      }
    }
  ],
  "permissions": [
    {
      "name": "device.identity",
      "required": false,
      "scope": "mac.wifi.station.hardware"
    }
  ],
  "release_sequence": 2
}
