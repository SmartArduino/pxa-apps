{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-lab",
  "version": "1.0.3",
  "release_sequence": 6,
  "name": "PXA ABI Lab",
  "description": "交互检查设备、时钟、存储、私有文件、WASI 与分配器。面向开发调试，操作前阅读页面提示。",
  "build": {
    "system": "cmake",
    "source_dir": "."
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "services": [
        "window",
        "ui",
        "device",
        "clock",
        "storage",
        "fs",
        "log"
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "random",
          "wall-clock"
        ]
      }
    }
  ],
  "ipc_endpoints": [],
  "permissions": []
}
