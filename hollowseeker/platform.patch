+void obono_reset_game(){
+ isStart=0;
+ isOver=0;
+ score=0;
+ scoreTop=0;
+ isHiscore=0;
+ counter=0;
+ caveOffset=0;
+ cavePhase=0;
+ caveHollowCnt=0;
+ caveLoopCnt=0;
+ caveMaxGap=0;
+ caveGap=0;
+ caveBaseTop=0;
+ caveBaseBottom=0;
+ memset(caveColumn,0,sizeof(caveColumn));
+ playerX=0;
+ playerColumn=0;
+ playerMove=0;
+ playerDir=0;
+ playerJump=0;
+ memset(debris,0,sizeof(debris));
+}
+void obono_pack_game(ObonoWriter&w){
+ w.u8(isStart);
+ w.u8(isOver);
+ w.u16(score);
+ w.u8(scoreTop);
+ w.u8(isHiscore);
+ w.u16(counter);
+ w.u8(caveOffset);
+ w.u16(cavePhase);
+ w.u8(caveHollowCnt);
+ w.u16(caveLoopCnt);
+ w.u8(caveMaxGap);
+ w.u16(caveGap);
+ w.u16(caveBaseTop);
+ w.u16(caveBaseBottom);
+ for(auto&v:caveColumn){w.u8(v.top);w.u8(v.bottom);}
+ w.u8(playerX);
+ w.u8(playerColumn);
+ w.u8(playerMove);
+ w.u8(playerDir);
+ w.u8(playerJump);
+ for(auto&v:debris){w.u8(v.t);w.u8(v.base);}
+}
+void obono_register_game(){
+ obono_audio_register(1,soundStart,sizeof(soundStart));
+ obono_audio_register(2,soundMove,sizeof(soundMove));
+ obono_audio_register(3,soundCrush,sizeof(soundCrush));
+ obono_audio_register(4,soundGameOver,sizeof(soundGameOver));
+}
