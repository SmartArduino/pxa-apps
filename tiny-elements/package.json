{
  "format": "pxa-package-source-0.2",
  "min_sdk": [2, 1],
  "target_sdk": [2, 1],
  "compile_sdk": [2, 1],
  "id": "pxa-tiny-elements",
  "version": "1.1.1",
  "name": "Tiny Elements",
  "description": "An original pocket particle garden: pour sand, grow forests, build firebreaks and cool lava. Ten materials, five worlds, touch painting and controller tools.",
  "publisher": {"handle": "lucinhu", "display_name": "lucinhu"},
  "release_sequence": 3,
  "build": {"system": "cmake", "source_dir": ".", "linear_memory": {"maximum_bytes": 1048576, "pinned": true}},
  "components": [{
    "id": "main", "kind": "ui", "cmake_target": "pxa_main", "execution_model": "main-loop", "artifact": "aot",
    "services": ["surface", "clock", "window", "ui", "log", "storage", "permission", {"name": "audio", "min_version": [0, 10]}],
    "wasi": {"version": "preview1", "libc": "wasi-libc", "features": ["monotonic-clock", "wall-clock"]}
  }],
  "permissions": [{"name": "audio.playback", "required": false, "scope": "media"}],
  "icon": "assets/icon.png"
}
