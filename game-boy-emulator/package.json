{
  "format": "pxa-package-source-0.2",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "id": "pxa-game-boy",
  "version": "0.1.58",
  "release_sequence": 59,
  "name": "GB/GBC Emulator",
  "description": "Game Boy and Game Boy Color emulator with SD/flash ROM library, audio and touch or gamepad controls",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 4194304,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "artifact": "aot",
      "services": [
        "surface",
        "window",
        "ui",
        "log",
        "permission",
        "audio",
        {
          "name": "clock",
          "min_version": [
            0,
            2
          ],
          "features": []
        },
        {
          "name": "fs",
          "min_version": [
            0,
            3
          ],
          "features": [
            "app-media-root",
            "read-at"
          ]
        },
        {
          "name": "assets",
          "min_version": [
            2,
            0
          ]
        }
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "random",
          "wall-clock"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "icon": "assets/icon.png",
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "resources": {
    "manifest_sha256": "9ca8fccd3b5e8a2c4c1329be6f0da1586e4106c3994aa84fbb49feb24e2ee198"
  }
}
