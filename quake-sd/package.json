{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "id": "pxa-quake-sd",
  "version": "0.4.24",
  "name": "Quake SD",
  "description": "Quake with native indexed output, exact light-grid caching and fixed SD resources",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 3670016,
      "pinned": true
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "services": [
        "surface",
        {
          "name": "audio",
          "min_version": [
            0,
            10
          ]
        },
        "clock",
        "permission",
        "window",
        "log",
        "ui",
        {
          "name": "fs",
          "min_version": [
            0,
            3
          ],
          "features": [
            "app-media-root",
            "read-at",
            "scoped-roots"
          ]
        },
        {
          "name": "game-render",
          "min_version": [
            1,
            2
          ],
          "features": [
            "borrowed-indexed-blit"
          ]
        }
      ],
      "cmake_target": "pxa_main",
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      },
      "artifact": "aot",
      "execution_model": "main-loop"
    }
  ],
  "permissions": [
    {
      "name": "audio.playback",
      "required": false,
      "scope": "media"
    }
  ],
  "release_sequence": 144
}
