{
  "format": "pxa-package-source-0.2",
  "id": "pxa-navigation",
  "version": "0.6.1",
  "release_sequence": 8,
  "min_sdk": [
    2,
    1
  ],
  "target_sdk": [
    2,
    1
  ],
  "compile_sdk": [
    2,
    1
  ],
  "name": "随行地图",
  "icon": "assets/icon.png",
  "description": "高德地图、地点搜索、步行骑行驾车路线，支持免费 Wi-Fi 定位、网络位置转发与模拟导航。",
  "publisher": {
    "handle": "lucinhu",
    "display_name": "lucinhu"
  },
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 4194304,
      "pinned": false
    }
  },
  "permissions": [
    {
      "name": "net.client",
      "scope": "web",
      "required": false
    },
    {
      "name": "org.doit.wifi-location",
      "scope": "wifi.scan",
      "required": false
    },
    {
      "name": "sensor.read",
      "scope": "magnetic-field.0",
      "required": false
    },
    {
      "name": "sensor.read",
      "scope": "magnetic-field.1",
      "required": false
    },
    {
      "name": "sensor.read",
      "scope": "motion.acceleration",
      "required": false
    },
    {
      "name": "sensor.read",
      "scope": "motion.angular-velocity",
      "required": false
    },
    {
      "name": "sensor.read",
      "scope": "orientation.heading",
      "required": false
    }
  ],
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "services": [
        {
          "name": "ui",
          "min_version": [
            0,
            6
          ],
          "features": [
            "canvas",
            "dynamic-text",
            "password-input",
            "sized-text"
          ]
        },
        "window",
        "clock",
        "storage",
        "permission",
        "log",
        {
          "name": "net",
          "min_version": [
            0,
            5
          ]
        },
        {
          "name": "assets",
          "min_version": [
            2,
            5
          ]
        },
        {
          "name": "sensor",
          "min_version": [
            0,
            1
          ]
        }
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "random",
          "wall-clock"
        ]
      }
    }
  ]
}
