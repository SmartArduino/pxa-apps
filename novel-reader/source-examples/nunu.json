{
  "format": "pxa-reader-source-2",
  "name": "努努书坊",
  "kind": "html",
  "searchUrl": "https://www.nunubook.com/e/search/index.php",
  "search": {
    "method": "POST",
    "body": "tbname=bookname&show=title%2Cwriter&tempid=1&keyboard={{key}}",
    "items": ".s-list-wrap li",
    "title": ".book-title .title",
    "link": "a@href",
    "author": ".book-author",
    "next": ".page_next@href"
  },
  "toc": {
    "paged": {
      "url": "/e/extend/bookpage/pages.php?id={{id}}&pageNum={{page}}&dz=asc",
      "id": "#bookDetails@data-bookid",
      "items": "list",
      "title": "title",
      "link": "pic",
      "pages": "totalPage",
      "total": "total"
    }
  },
  "content": {
    "selector": "#text",
    "remove": [
      "script",
      "style",
      ".ad"
    ]
  }
}
