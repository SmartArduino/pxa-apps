{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-novel-reader",
  "version": "0.1.2",
  "release_sequence": 3,
  "name": "书页阅读",
  "description": "支持离线 TXT 与可配置的 JSON 网络书源，提供搜索、章节导航、下载、自适应字体和自动翻页。网络书源需自行配置；离线阅读不依赖网络。",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 2097152,
      "pinned": false
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "services": [
        {
          "name": "ui",
          "features": [
            "dynamic-text",
            "sized-text",
            "text-input-control"
          ]
        },
        "window",
        "net",
        "permission",
        "fs",
        "storage",
        "clock",
        "log"
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "net.client",
      "scope": "web",
      "required": false
    }
  ]
}
