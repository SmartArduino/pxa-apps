{
  "format": "pxa-package-source-0.1",
  "min_sdk": [
    2,
    0
  ],
  "target_sdk": [
    2,
    0
  ],
  "compile_sdk": [
    2,
    0
  ],
  "id": "pxa-novel-reader",
  "version": "0.2.6",
  "release_sequence": 10,
  "name": "书页阅读",
  "icon": "assets/icon.png",
  "description": "真实阅读网站站内搜索、完整分章目录，默认按需阅读不保存正文；支持离线下载、自定义 TXT/JSON/HTML 书源和自适应排版。",
  "build": {
    "system": "cmake",
    "source_dir": ".",
    "linear_memory": {
      "maximum_bytes": 2097152,
      "pinned": false
    }
  },
  "components": [
    {
      "id": "main",
      "kind": "ui",
      "cmake_target": "pxa_main",
      "services": [
        {
          "name": "ui",
          "features": [
            "dynamic-text",
            "sized-text",
            "text-input-control"
          ]
        },
        "window",
        "net",
        "permission",
        "fs",
        "storage",
        "clock",
        "log"
      ],
      "wasi": {
        "version": "preview1",
        "libc": "wasi-libc",
        "features": [
          "monotonic-clock",
          "wall-clock"
        ]
      }
    }
  ],
  "permissions": [
    {
      "name": "net.client",
      "scope": "web",
      "required": false
    }
  ]
}
