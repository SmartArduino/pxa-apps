-void ArduboyTones::tone(uint16_t freq, uint16_t dur)
-{
-  bitWrite(TIMSK3, OCIE3A, 0); // disable the output compare match interrupt
-  inProgmem = false;
-  tonesStart = tonesIndex = toneSequence; // set to start of sequence array
